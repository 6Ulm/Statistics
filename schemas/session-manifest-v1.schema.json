{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengshuicompass.example/schemas/session-manifest-v1.schema.json",
  "title": "Session manifest v1",
  "description": "SPEC.md §37.2 reproducibility package. configVersion/configHash MUST match the telemetry envelope for every event in the run — one identifier for the acceptance configuration, never a second manifest name that can drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","protocol","sessionId","truthReference","truthTier","truthExpandedUncertaintyDeg","truthCoverageFactor","fixture","headingsDeg","repetitions","measurementMode","placementMethod","placementProfileId","placementProfileHash","settleS","captureS","randomizationSeed","configVersion","configHash","fengShuiRuleSetVersion","fengShuiRuleSetHash","geomagneticModelId","geomagneticCoefficientHash","geomagneticErrorModelHash","engineVersion","engineDecisionLogicHash"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "protocol": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "site": { "type": "string" },
    "operator": { "type": "string" },
    "deviceUnit": { "type": "string" },
    "truthReference": { "type": "string", "minLength": 1 },
    "truthTier": { "type": "string", "enum": ["TIER_0A","TIER_0B","TIER_0C","TIER_1","TIER_2"] },
    "truthExpandedUncertaintyDeg": { "type": "number", "exclusiveMinimum": 0 },
    "truthCoverageFactor": { "type": "number", "exclusiveMinimum": 0 },
    "fixture": { "type": "string", "minLength": 1 },
    "headingsDeg": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 } },
    "repetitions": { "type": "integer", "minimum": 1 },
    "measurementMode": { "type": "string", "enum": ["FLAT_TOP_EDGE","WALL_FLUSH_BACK"] },
    "placementMethod": { "type": "string", "enum": ["FREEHAND","WALL_FLUSH_FREEHAND","NONMAGNETIC_ALIGNMENT_JIG","SURVEY_FIXTURE"] },
    "placementProfileId": { "type": "string", "minLength": 1 },
    "placementProfileHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "settleS": { "type": "number", "minimum": 0 },
    "captureS": { "type": "number", "exclusiveMinimum": 0 },
    "randomizationSeed": { "type": "integer" },
    "configVersion": { "type": "string", "minLength": 1 },
    "configHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fengShuiRuleSetVersion": { "type": "string", "minLength": 1 },
    "fengShuiRuleSetHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "geomagneticModelId": { "type": "string", "enum": ["WMM2025","WMMHR2025"] },
    "geomagneticCoefficientHash": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|NOT_VENDORED)$" },
    "geomagneticErrorModelHash": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|NOT_VENDORED)$" },
    "engineVersion": { "type": "string", "minLength": 1 },
    "engineDecisionLogicHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
