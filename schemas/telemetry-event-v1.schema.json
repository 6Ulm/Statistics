{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengshuicompass.example/schemas/telemetry-event-v1.schema.json",
  "title": "Telemetry event v1",
  "description": "SPEC.md §22 common envelope plus a typed payload, one JSON object per JSONL line. §22.2 encoding rules are enforced structurally where JSON Schema can (no nonfinite literals are representable in JSON at all; RFC 3339 UTC with explicit Z; integer nanoseconds with a named clock domain) and by the encoder/decoder tests named in docs/TESTING.md otherwise (locale independence, shortest round-trip doubles, casing).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","sessionId","eventId","eventType","platform","appVersion","appBuild","engineVersion","configVersion","configHash","deviceAnonymousId","hardwareRuntimeIdentity","sensorRuntimeIdentity","osBuildIdentity","wallTimeUtc","recordMonotonicTimeNs","sourceClock","clockMappingId","sequence","payload"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "eventId": { "type": "integer", "minimum": 0 },
    "eventType": {
      "description": "§22 event-type identifiers are a lower_snake_case namespace separate from enum values.",
      "type": "string",
      "enum": [
        "session_start","session_end","app_lifecycle",
        "clock_mapping","ground_truth","fixture_state",
        "location_sample","location_authorization","location_provider_state",
        "magnetometer_calibrated","magnetometer_uncalibrated",
        "accelerometer","gravity","gyroscope","rotation_vector","device_motion",
        "os_heading","fused_orientation",
        "capability_resolution",
        "wmm_output","reference_resolution","engine_output","state_transition","precision_lock",
        "sensor_health",
        "calibration_request","calibration_prompt","calibration_result",
        "target_heading_request","target_guidance",
        "deviation_profile_lookup","deviation_correction",
        "certification_lookup",
        "display_frame_marker",
        "thermal_state","battery_state","charging_state","power_mode",
        "space_weather_advisory",
        "orientation_change","sensor_discontinuity","dropped_sample_summary",
        "user_action"
      ]
    },
    "platform": { "type": "string", "enum": ["ANDROID","IOS","ANALYSIS"] },
    "appVersion": { "type": "string", "minLength": 1 },
    "appBuild": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "configVersion": { "type": "string", "minLength": 1 },
    "configHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "deviceAnonymousId": { "type": "string", "minLength": 1 },
    "hardwareRuntimeIdentity": { "type": "string", "minLength": 1 },
    "sensorRuntimeIdentity": { "type": "string", "minLength": 1 },
    "osBuildIdentity": { "type": "string", "minLength": 1 },
    "wallTimeUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "recordMonotonicTimeNs": { "type": "integer", "minimum": 0 },
    "sourceMonotonicTimeNs": { "type": ["integer","null"], "minimum": 0 },
    "arrivalMonotonicTimeNs": { "type": ["integer","null"], "minimum": 0 },
    "sourceClock": { "type": "string", "enum": ["ELAPSED_REALTIME","CORE_MOTION_BOOT_TIME","PROVIDER_DATE","FIXTURE_CLOCK"] },
    "clockMappingId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  }
}
